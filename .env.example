# Copy to .env and fill in real values. Never commit .env.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Which environment this is: local, staging or production.
ENVIRONMENT=local

# Postgres connection. Port 5433 matches docker-compose.yml on your machine (CI uses 5432).
DATABASE_URL=postgresql+psycopg://niche:niche@localhost:5433/nicheconnect

# Database connection pool: open connections kept, extra allowed under load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Longest a single database query may run, in milliseconds, before it is cancelled.
DB_STATEMENT_TIMEOUT_MS=5000

# Redis connection (rate limits, cache, jobs).
REDIS_URL=redis://localhost:6379/0

# Signs access tokens (D-008). At least 32 characters; the app refuses the placeholder.
SECRET_KEY=change-me-generate-a-real-key

# Keys the hash of one-time login codes (D-011). Must differ from SECRET_KEY.
OTP_HASH_KEY=change-me-generate-a-different-key

# Access token lifetime in minutes (D-008). Maximum 15.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (D-008). Maximum 30.
REFRESH_TOKEN_EXPIRE_DAYS=30

# WhatsApp Business API token. Not used yet; leave empty until the provider is decided.
WHATSAPP_BUSINESS_TOKEN=

# Claude API key. Not used yet; leave empty until an AI feature is approved.
ANTHROPIC_API_KEY=
