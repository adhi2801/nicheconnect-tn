{
  "$description": "Colyv's one design-token source, in the W3C Design Tokens format (2025.10). Colours are OKLCH, so light and dark keep equal perceived contrast. Three layers: palette (raw colours), theme (what each colour means, light and dark), brand (the accent, two candidates until the colour test decides, docs/PROPOSAL_FRONTEND_ARCHITECTURE.md section 4). Style: granite and light (docs/research/UI_STYLES_2026.md): a calm warm-neutral base, one accent used sparingly, state colours that always mean the same thing, gold only on what is sealed. Run `pnpm tokens` after any change: it regenerates the CSS and Dart and fails if any text and background pair misses its contrast bar (docs/standards/frontend.md section 6).",

  "theme": {
    "light": {
      "$description": "Warm stone and paper: never a plain white ground (white is mourning, TAMIL_DESIGN_ROOTS.md section 7).",
      "ground":         { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.968, 0.010, 80] } },
      "surface":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.993, 0.004, 85] } },
      "surface-raised": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.998, 0.002, 85] } },
      "sunk":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.945, 0.012, 78] } },
      "ink":            { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.215, 0.018, 55] } },
      "ink-muted":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.425, 0.022, 60] } },
      "line":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.905, 0.012, 75] } },
      "line-strong":    { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.590, 0.018, 70] } },
      "focus":          { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.215, 0.018, 55] } },
      "ok":             { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.420, 0.100, 152] } },
      "ok-soft":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.955, 0.030, 152] } },
      "warn":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.440, 0.090, 78] } },
      "warn-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.960, 0.040, 90] } },
      "bad":            { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.440, 0.160, 27] } },
      "bad-soft":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.955, 0.020, 25] } },
      "seal":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.740, 0.120, 82] } },
      "seal-hi":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.905, 0.075, 92] } },
      "seal-lo":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.500, 0.095, 72] } },
      "on-seal":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.270, 0.050, 68] } }
    },
    "dark": {
      "$description": "Temple dusk: indigo night with lamp-cream text (TAMIL_DESIGN_ROOTS.md sections 8 and 12.13). Opt-in with data-theme=\"dark\" until every component passes its dark screenshots.",
      "ground":         { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.165, 0.020, 268] } },
      "surface":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0.022, 268] } },
      "surface-raised": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.240, 0.024, 268] } },
      "sunk":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.140, 0.018, 268] } },
      "ink":            { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.955, 0.012, 85] } },
      "ink-muted":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.810, 0.018, 80] } },
      "line":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.300, 0.020, 268] } },
      "line-strong":    { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.560, 0.020, 268] } },
      "focus":          { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.955, 0.012, 85] } },
      "ok":             { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.820, 0.120, 152] } },
      "ok-soft":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.270, 0.050, 152] } },
      "warn":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.850, 0.110, 88] } },
      "warn-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.285, 0.050, 80] } },
      "bad":            { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.790, 0.120, 25] } },
      "bad-soft":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.285, 0.050, 25] } },
      "seal":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.800, 0.120, 85] } },
      "seal-hi":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.925, 0.070, 92] } },
      "seal-lo":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.580, 0.100, 75] } },
      "on-seal":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.220, 0.040, 70] } }
    }
  },

  "brand": {
    "$description": "The accent, and nothing else, changes with the brand. Burgundy is the default (Adhi, 30 October 2026) until the five-second test chooses; green is Harish's direction of 28 October. `accent` fills buttons; `accent-ink` is the accent used as text, so it can differ on dark.",
    "burgundy": {
      "light": {
        "accent":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.395, 0.135, 12] } },
        "accent-hover":     { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.350, 0.125, 12] } },
        "accent-pressed":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.310, 0.110, 12] } },
        "on-accent":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.990, 0.005, 85] } },
        "accent-ink":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.395, 0.135, 12] } },
        "accent-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.952, 0.022, 12] } },
        "on-accent-soft":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.360, 0.120, 12] } },
        "accent-mid":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.600, 0.120, 14] } },
        "accent-deep-from": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.360, 0.120, 14] } },
        "accent-deep-to":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.240, 0.080, 10] } }
      },
      "dark": {
        "accent":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.540, 0.150, 14] } },
        "accent-hover":     { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.500, 0.145, 14] } },
        "accent-pressed":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.460, 0.140, 14] } },
        "on-accent":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.990, 0.005, 85] } },
        "accent-ink":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.800, 0.100, 14] } },
        "accent-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.280, 0.060, 14] } },
        "on-accent-soft":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.890, 0.055, 14] } },
        "accent-mid":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.640, 0.130, 14] } },
        "accent-deep-from": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.360, 0.120, 14] } },
        "accent-deep-to":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.220, 0.070, 10] } }
      }
    },
    "green": {
      "light": {
        "accent":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.420, 0.090, 155] } },
        "accent-hover":     { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.370, 0.080, 155] } },
        "accent-pressed":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.330, 0.070, 155] } },
        "on-accent":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.990, 0.005, 85] } },
        "accent-ink":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.400, 0.085, 155] } },
        "accent-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.950, 0.030, 155] } },
        "on-accent-soft":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.330, 0.080, 155] } },
        "accent-mid":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.620, 0.110, 152] } },
        "accent-deep-from": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.450, 0.100, 155] } },
        "accent-deep-to":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.300, 0.065, 158] } }
      },
      "dark": {
        "accent":           { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.500, 0.100, 155] } },
        "accent-hover":     { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.530, 0.100, 155] } },
        "accent-pressed":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.450, 0.090, 155] } },
        "on-accent":        { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.990, 0.005, 85] } },
        "accent-ink":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.810, 0.100, 155] } },
        "accent-soft":      { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.280, 0.045, 155] } },
        "on-accent-soft":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.880, 0.070, 155] } },
        "accent-mid":       { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.660, 0.110, 152] } },
        "accent-deep-from": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.420, 0.090, 155] } },
        "accent-deep-to":   { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.260, 0.060, 158] } }
      }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "A 4-point scale. Layouts use 8-point steps; 2 and 4 are for hairline gaps inside components.",
    "0-5": { "$value": { "value": 2, "unit": "px" } },
    "1":   { "$value": { "value": 4, "unit": "px" } },
    "2":   { "$value": { "value": 8, "unit": "px" } },
    "3":   { "$value": { "value": 12, "unit": "px" } },
    "4":   { "$value": { "value": 16, "unit": "px" } },
    "5":   { "$value": { "value": 20, "unit": "px" } },
    "6":   { "$value": { "value": 24, "unit": "px" } },
    "8":   { "$value": { "value": 32, "unit": "px" } },
    "10":  { "$value": { "value": 40, "unit": "px" } },
    "12":  { "$value": { "value": 48, "unit": "px" } },
    "16":  { "$value": { "value": 64, "unit": "px" } },
    "20":  { "$value": { "value": 80, "unit": "px" } },
    "24":  { "$value": { "value": 96, "unit": "px" } },
    "32":  { "$value": { "value": 128, "unit": "px" } }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 8, "unit": "px" } },
    "md":   { "$value": { "value": 12, "unit": "px" } },
    "lg":   { "$value": { "value": 16, "unit": "px" } },
    "xl":   { "$value": { "value": 24, "unit": "px" } },
    "2xl":  { "$value": { "value": 32, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },

  "font": {
    "$type": "fontFamily",
    "$description": "Display serif for headlines only, one UI sans for everything people read, mono for fingerprints and references. The pairing is judged in the type specimen before it binds.",
    "display": { "$value": ["Fraunces", "Iowan Old Style", "Palatino Linotype", "Georgia", "serif"] },
    "ui":      { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },

  "type": {
    "$description": "Size and line height in px, weight, tracking in em. Money and counts use tabular numerals (font-variant-numeric).",
    "caption":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 12, "unit": "px" }, "lineHeight": 1.333, "fontWeight": 500, "letterSpacing": { "value": 0.01, "unit": "em" } } },
    "footnote":   { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 13, "unit": "px" }, "lineHeight": 1.385, "fontWeight": 400, "letterSpacing": { "value": 0, "unit": "em" } } },
    "callout":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 15, "unit": "px" }, "lineHeight": 1.467, "fontWeight": 400, "letterSpacing": { "value": 0, "unit": "em" } } },
    "body":       { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 16, "unit": "px" }, "lineHeight": 1.5, "fontWeight": 400, "letterSpacing": { "value": 0, "unit": "em" } } },
    "body-lg":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 18, "unit": "px" }, "lineHeight": 1.556, "fontWeight": 400, "letterSpacing": { "value": -0.005, "unit": "em" } } },
    "headline":   { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 17, "unit": "px" }, "lineHeight": 1.294, "fontWeight": 600, "letterSpacing": { "value": -0.005, "unit": "em" } } },
    "title-3":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 20, "unit": "px" }, "lineHeight": 1.3, "fontWeight": 600, "letterSpacing": { "value": -0.01, "unit": "em" } } },
    "title-2":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontSize": { "value": 24, "unit": "px" }, "lineHeight": 1.25, "fontWeight": 600, "letterSpacing": { "value": -0.015, "unit": "em" } } },
    "title-1":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": { "value": 30, "unit": "px" }, "lineHeight": 1.2, "fontWeight": 500, "letterSpacing": { "value": -0.015, "unit": "em" } } },
    "display-s":  { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": { "value": 40, "unit": "px" }, "lineHeight": 1.1, "fontWeight": 500, "letterSpacing": { "value": -0.02, "unit": "em" } } },
    "display-m":  { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": { "value": 52, "unit": "px" }, "lineHeight": 1.04, "fontWeight": 500, "letterSpacing": { "value": -0.025, "unit": "em" } } },
    "display-l":  { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": { "value": 68, "unit": "px" }, "lineHeight": 1.0, "fontWeight": 500, "letterSpacing": { "value": -0.03, "unit": "em" } } },
    "display-xl": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": { "value": 88, "unit": "px" }, "lineHeight": 0.98, "fontWeight": 500, "letterSpacing": { "value": -0.035, "unit": "em" } } }
  },

  "duration": {
    "$type": "duration",
    "$description": "From docs/standards/frontend.md section 8c. A press answers at once; a section takes its time; nothing loops.",
    "instant": { "$value": { "value": 80, "unit": "ms" } },
    "press":   { "$value": { "value": 140, "unit": "ms" } },
    "state":   { "$value": { "value": 220, "unit": "ms" } },
    "overlay": { "$value": { "value": 280, "unit": "ms" } },
    "enter":   { "$value": { "value": 480, "unit": "ms" } },
    "section": { "$value": { "value": 640, "unit": "ms" } },
    "scene":   { "$value": { "value": 1200, "unit": "ms" } }
  },

  "easing": {
    "$type": "cubicBezier",
    "$description": "Every movement ends in a clear still pose (TAMIL_DESIGN_ROOTS.md 12.7): decelerate into rest, accelerate out of view.",
    "standard":   { "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$value": [0.05, 0.7, 0.1, 1] },
    "accelerate": { "$value": [0.3, 0, 0.8, 0.15] },
    "linear":     { "$value": [0, 0, 1, 1] }
  },

  "spring": {
    "$description": "For anything a finger drags or that settles physically. Not in the W3C format yet, so kept as an extension.",
    "$extensions": {
      "colyv.spring": {
        "snappy": { "stiffness": 520, "damping": 42, "mass": 1 },
        "settle": { "stiffness": 260, "damping": 32, "mass": 1 },
        "gentle": { "stiffness": 170, "damping": 26, "mass": 1 }
      }
    }
  },

  "elevation": {
    "$description": "Shadows are tinted by the theme's ink, never pure black on the light theme.",
    "light": {
      "1": "0 1px 2px oklch(0.215 0.018 55 / 0.06)",
      "2": "0 1px 2px oklch(0.215 0.018 55 / 0.05), 0 12px 32px -16px oklch(0.215 0.018 55 / 0.18)",
      "3": "0 2px 6px oklch(0.215 0.018 55 / 0.08), 0 28px 64px -24px oklch(0.215 0.018 55 / 0.30)"
    },
    "dark": {
      "1": "0 1px 2px oklch(0 0 0 / 0.40)",
      "2": "0 1px 2px oklch(0 0 0 / 0.40), 0 12px 32px -16px oklch(0 0 0 / 0.55)",
      "3": "0 2px 6px oklch(0 0 0 / 0.45), 0 28px 64px -24px oklch(0 0 0 / 0.70)"
    }
  },

  "contrast": {
    "$description": "Every pair the build checks, in every theme and brand. 7 for anything read as body text, 4.5 for button labels and large text, 3 for borders and focus rings (docs/standards/frontend.md section 6).",
    "pairs": [
      ["ink", "ground", 7], ["ink", "surface", 7], ["ink", "sunk", 7], ["ink", "surface-raised", 7],
      ["ink-muted", "ground", 7], ["ink-muted", "surface", 7], ["ink-muted", "sunk", 7],
      ["accent-ink", "surface", 7], ["accent-ink", "ground", 7],
      ["on-accent-soft", "accent-soft", 7],
      ["ok", "ok-soft", 7], ["warn", "warn-soft", 7], ["bad", "bad-soft", 7],
      ["ok", "surface", 7], ["warn", "surface", 7], ["bad", "surface", 7],
      ["on-seal", "seal", 4.5],
      ["on-accent", "accent", 4.5], ["on-accent", "accent-hover", 4.5], ["on-accent", "accent-pressed", 4.5],
      ["on-accent", "accent-deep-from", 4.5], ["on-accent", "accent-deep-to", 4.5],
      ["line-strong", "surface", 3], ["line-strong", "ground", 3],
      ["focus", "surface", 3], ["focus", "ground", 3],
      ["accent", "surface", 3], ["bad", "ground", 3]
    ]
  },

  "legacy": {
    "$description": "Names the first design system (28 October) used, kept as aliases so its screens and the Flutter app keep working while components move to the names above. Remove each one once nothing uses it.",
    "aliases": {
      "surface-sunk": "sunk", "highlight": "accent-soft", "highlight-deep": "accent-mid",
      "highlight-soft": "accent-soft", "on-highlight": "on-accent-soft",
      "hero-from": "accent-deep-from", "hero-to": "accent-deep-to",
      "gauge-deep": "accent", "gauge-mid": "accent-mid",
      "glance-gold-from": "seal-hi", "glance-gold-to": "seal",
      "glance-terracotta-from": "accent-soft", "glance-terracotta-to": "accent-mid",
      "glance-clay-from": "sunk", "glance-clay-to": "line-strong",
      "glance-sand-from": "ground", "glance-sand-to": "line"
    }
  }
}
