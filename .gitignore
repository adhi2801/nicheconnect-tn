__pycache__/
*.pyc
.env
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.DS_Store
*.log
.claude/*
!.claude/commands/
.coverage
coverage.json
# Schemathesis keeps its test database and replay state here (D-047).
.schemathesis/

# OpenTofu (D-063). Its working folder is rebuilt by `tofu init`; state holds
# every generated password and lives only in the encrypted state bucket; a
# variables file may hold real values. None of them belongs in git.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Private working files that never belong in git, such as the proof reader's
# test set: screenshots of the founders' own posts (D-070, step 2).
local/
pytest.log
